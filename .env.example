# Copy to .env.local and fill in. Never commit .env or .env.local.

# Neon Postgres pooled connection string (postgres://...sslmode=require)
DATABASE_URL=

# Ticketmaster Discovery API — https://developer.ticketmaster.com/
# Passed as `apikey` query param. The consumer secret is NOT required for the
# Discovery API (it's only needed for OAuth-protected endpoints).
TICKETMASTER_CONSUMER_KEY=

# SeatGeek API — https://platform.seatgeek.com/
SEATGEEK_API_KEY=

# Resend transactional email — https://resend.com/
RESEND_API_KEY=
